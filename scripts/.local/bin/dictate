#!/usr/bin/env -S python3 -I

# ┏━━━━━━━━━┓
# ┃ dictate ┃
# ┗━━━━━━━━━┛
"""Fn or Right Ctrl: tap toggles voxtype recording, hold is push-to-talk.

Another key pressed while the trigger is held cancels the recording.
Runs in the background, listening to keyboard evdev devices.
"""

import glob
import os
import select
import struct
import subprocess
import time

KEY_WAKEUP = 143
KEY_RIGHTCTRL = 97
TRIGGER_KEYS = {KEY_WAKEUP, KEY_RIGHTCTRL}
EV_KEY = 1
HOLD_THRESHOLD_SECS = 0.3
INPUT_EVENT = struct.Struct('llHHi')


def voxtype(*, args: list[str]) -> str:
    """Run `voxtype <args...>` and return its stdout."""
    result = subprocess.run(['voxtype', *args],
                            capture_output=True,
                            text=True,
                            check=False)
    return result.stdout.strip()


def find_keyboard_paths() -> set[str]:
    keyboard_paths = (glob.glob('/dev/input/by-path/*-event-kbd') +
                      glob.glob('/dev/input/by-id/*-event-kbd'))
    return {os.path.realpath(path) for path in keyboard_paths}


def open_new_keyboards(*, keyboard_fds: dict[str, int]) -> None:
    for real_path in find_keyboard_paths() - keyboard_fds.keys():
        try:
            keyboard_fds[real_path] = os.open(real_path,
                                              os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            continue


def read_events(*, keyboard_fds: dict[str, int],
                real_path: str) -> list[tuple[int, int, int]]:
    """Read pending events as (type, code, value); drop the device if gone."""
    try:
        event_bytes = os.read(keyboard_fds[real_path], INPUT_EVENT.size * 64)
    except BlockingIOError:
        return []
    except OSError:
        os.close(keyboard_fds.pop(real_path))
        return []

    last_offset = len(event_bytes) - INPUT_EVENT.size + 1
    events = []
    for offset in range(0, last_offset, INPUT_EVENT.size):
        _, _, event_type, key_code, key_value = (
            INPUT_EVENT.unpack_from(event_bytes, offset))
        events.append((event_type, key_code, key_value))
    return events


def main() -> None:
    keyboard_fds: dict[str, int] = {}
    is_armed = False
    pressed_at_secs = 0.0

    while True:
        open_new_keyboards(keyboard_fds=keyboard_fds)
        path_by_fd = {fd: path for path, fd in keyboard_fds.items()}
        readable_fds, _, _ = select.select(list(path_by_fd), [], [], 1)

        for device_fd in readable_fds:
            events = read_events(keyboard_fds=keyboard_fds,
                                 real_path=path_by_fd[device_fd])

            for event_type, key_code, key_value in events:
                if event_type != EV_KEY or key_value == 2:
                    continue

                if key_code in TRIGGER_KEYS and key_value == 1:
                    voxtype_status = voxtype(args=['status'])
                    if voxtype_status == 'recording':
                        voxtype(args=['record', 'stop'])
                        is_armed = False
                    elif voxtype_status in ('transcribing', 'stopped'):
                        is_armed = False
                    else:
                        voxtype(args=['record', 'start'])
                        is_armed = True
                        pressed_at_secs = time.monotonic()
                elif key_code in TRIGGER_KEYS and is_armed:
                    is_armed = False
                    if time.monotonic() - pressed_at_secs >= (
                            HOLD_THRESHOLD_SECS):
                        voxtype(args=['record', 'stop'])
                elif key_value == 1 and is_armed:
                    voxtype(args=['record', 'cancel'])
                    is_armed = False


if __name__ == '__main__':
    main()
