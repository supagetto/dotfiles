#!/usr/bin/env -S python3 -I

# ┏━━━━━━━━━┓
# ┃ dictate ┃
# ┗━━━━━━━━━┛
"""Fn or Right Ctrl: tap toggles voxtype recording, hold is push-to-talk."""

import fcntl
import glob
import os
import select
import struct
import subprocess
import time

KEY_WAKEUP = 143
KEY_RIGHTCTRL = 97
TRIGGER_KEYS = {KEY_WAKEUP, KEY_RIGHTCTRL}
EV_KEY = 1
HOLD_THRESHOLD_SECS = 0.3
MAX_RECORDING_SECS = 300
KEY_STATE_BYTES = 96
EVIOCGKEY = ((2 << 30) | (KEY_STATE_BYTES << 16) | (ord('E') << 8) | 0x18)
INPUT_EVENT = struct.Struct('llHHi')


def voxtype(*, args: list[str]) -> str:
    """Run `voxtype <args...>` and return its stdout."""
    result = subprocess.run(['voxtype', *args],
                            capture_output=True,
                            text=True,
                            check=False)
    return result.stdout.strip()


def is_trigger_down(*, device_fd: int) -> bool:
    key_state = bytearray(KEY_STATE_BYTES)
    fcntl.ioctl(device_fd, EVIOCGKEY, key_state)
    return any(key_state[key // 8] >> (key % 8) & 1 for key in TRIGGER_KEYS)


def wait_for_trigger_release(*, keyboard_fds: list[int],
                             pressed_at_secs: float) -> str:
    """Wait for the trigger key release.

    Returns 'released', 'combo' (another key was pressed) or 'timeout'.
    """
    while time.monotonic() - pressed_at_secs < MAX_RECORDING_SECS:
        readable_fds, _, _ = select.select(keyboard_fds, [], [], 1)
        for device_fd in readable_fds:
            try:
                event_bytes = os.read(device_fd, INPUT_EVENT.size * 64)
            except BlockingIOError:
                continue
            last_offset = len(event_bytes) - INPUT_EVENT.size + 1
            for offset in range(0, last_offset, INPUT_EVENT.size):
                _, _, event_type, key_code, key_value = (
                    INPUT_EVENT.unpack_from(event_bytes, offset))

                if event_type != EV_KEY:
                    continue

                if key_code in TRIGGER_KEYS:
                    if key_value == 0:
                        return 'released'
                elif key_value == 1:
                    return 'combo'
    return 'timeout'


def main() -> None:
    # Trigger press time; used for the hold threshold and max recording time.
    pressed_at_secs = time.monotonic()

    keyboard_paths = (glob.glob('/dev/input/by-path/*-event-kbd') +
                      glob.glob('/dev/input/by-id/*-event-kbd'))
    keyboard_fds = [
        os.open(real_path, os.O_RDONLY | os.O_NONBLOCK)
        for real_path in {os.path.realpath(path) for path in keyboard_paths}
    ]

    voxtype_status = voxtype(args=['status'])

    if voxtype_status == 'recording':
        voxtype(args=['record', 'stop'])
        return

    if voxtype_status in ('transcribing', 'stopped'):
        return

    voxtype(args=['record', 'start'])

    is_any_trigger_down = any(
        is_trigger_down(device_fd=device_fd) for device_fd in keyboard_fds)

    if not is_any_trigger_down:
        # tap: recording stays on
        return

    release_result = wait_for_trigger_release(keyboard_fds=keyboard_fds,
                                              pressed_at_secs=pressed_at_secs)

    if release_result == 'combo':
        voxtype(args=['record', 'cancel'])
        return

    if (release_result == 'released' and
            time.monotonic() - pressed_at_secs < HOLD_THRESHOLD_SECS):
        # tap
        return

    voxtype(args=['record', 'stop'])


if __name__ == '__main__':
    main()
