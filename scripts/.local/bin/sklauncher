#!/usr/bin/env bash

# ┏━━━━━━━━━━━━┓
# ┃ sklauncher ┃
# ┗━━━━━━━━━━━━┛

source "lib"

print_usage() {
  cat <<END
Usage:
  ${SCRIPT_NAME} [option]

Options:
  -h, --help  Show usage.
END
}

launch() {
  if [[ "$#" -ne 0 ]]; then
    lib::print_invalid_argument_error "$1"
    return 1
  fi

  exec /usr/lib/jvm/java-25-openjdk/bin/java \
    -jar /usr/share/java/sklauncher/SKlauncher.jar
}

handle_option() {
  case "$1" in
    -h | --help)
      if [[ "$#" -gt 1 ]]; then
        lib::print_invalid_argument_error "$2"
        return 1
      fi

      print_usage
      return
      ;;
    *)
      lib::print_error "Invalid \`$1\` option."
      return 1
      ;;
  esac
}

main() {
  if lib::is_option "$1"; then
    handle_option "$@"
    exit
  fi

  launch "$@"
}

main "$@"
